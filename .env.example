# Copy to .env and edit. Placeholders only; no secrets are needed (no paid APIs).

# Model profile: demo-fast | quality | safeguard
PROFILE=demo-fast

# Per-role model override, e.g. ROLE_CLAIM_CHECKER=gpt-oss-20b
# ROLE_CLAIM_CHECKER=qwen-8b
# Fallback when qwen3:8b is not pulled but qwen2.5:7b is (set for every checker role):
# ROLE_PAGE_READER=qwen25-7b
# ROLE_CLAIM_CHECKER=qwen25-7b

# Models pulled by the ollama-pull init step (space separated Ollama tags)
PULL_MODELS=gpt-oss:120b qwen3:32b nomic-embed-text

# Service URLs (defaults work inside docker compose)
OLLAMA_URL=http://ollama:11434
SEARXNG_URL=http://searxng:8080

# Search: live | cache_only | fixtures
SEARCH_MODE=live
# Search provider: auto (default) | searxng | tavily
#   auto: Tavily (OPTIONAL hosted search API) when TAVILY_API_KEY is set, else self-hosted SearXNG.
#   Without a key, or when Tavily errors or runs out of credits, each query falls back to SearXNG (logged).
SEARCH_PROVIDER=auto
# Your own free key from tavily.com (free tier ~1,000 credits/month, 1 credit per search). Leave empty for SearXNG only.
# TAVILY_API_KEY=

# Founder mode: explore | delegate | evaluate
FOUNDER_MODE=explore

# Storage locations inside the container
DATA_DIR=/app/data
OUTPUTS_DIR=/app/outputs
# Root decision log written by `python -m app.cli publish`
DECISION_LOG_PATH=/app/decision_log.json

# LLM request timeout in seconds
LLM_TIMEOUT=240
